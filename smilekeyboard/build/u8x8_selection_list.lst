  38:BSP/u8g2/u8x8_selection_list.c **** #include "u8x8.h"
  39:BSP/u8g2/u8x8_selection_list.c **** 
  40:BSP/u8g2/u8x8_selection_list.c **** /*
  41:BSP/u8g2/u8x8_selection_list.c ****   increase the cursor position
  42:BSP/u8g2/u8x8_selection_list.c **** */
  43:BSP/u8g2/u8x8_selection_list.c **** void u8sl_Next(u8sl_t *u8sl)
  44:BSP/u8g2/u8x8_selection_list.c **** {
  45:BSP/u8g2/u8x8_selection_list.c ****   u8sl->current_pos++;
  46:BSP/u8g2/u8x8_selection_list.c ****   if ( u8sl->current_pos >= u8sl->total )
  47:BSP/u8g2/u8x8_selection_list.c ****   {
  48:BSP/u8g2/u8x8_selection_list.c ****     u8sl->current_pos = 0;
  49:BSP/u8g2/u8x8_selection_list.c ****     u8sl->first_pos = 0;
  50:BSP/u8g2/u8x8_selection_list.c ****   }
  51:BSP/u8g2/u8x8_selection_list.c ****   else
  52:BSP/u8g2/u8x8_selection_list.c ****   {
  53:BSP/u8g2/u8x8_selection_list.c ****     if ( u8sl->first_pos + u8sl->visible <= u8sl->current_pos + 1 )
  54:BSP/u8g2/u8x8_selection_list.c ****     {
  55:BSP/u8g2/u8x8_selection_list.c ****       u8sl->first_pos = u8sl->current_pos - u8sl->visible + 1;
  56:BSP/u8g2/u8x8_selection_list.c ****     }
  57:BSP/u8g2/u8x8_selection_list.c ****   }
  58:BSP/u8g2/u8x8_selection_list.c **** }
  59:BSP/u8g2/u8x8_selection_list.c **** 
  60:BSP/u8g2/u8x8_selection_list.c **** void u8sl_Prev(u8sl_t *u8sl)
  61:BSP/u8g2/u8x8_selection_list.c **** {
  62:BSP/u8g2/u8x8_selection_list.c ****   if ( u8sl->current_pos == 0 )
  63:BSP/u8g2/u8x8_selection_list.c ****   {
  64:BSP/u8g2/u8x8_selection_list.c ****     u8sl->current_pos = u8sl->total - 1;
  65:BSP/u8g2/u8x8_selection_list.c ****     u8sl->first_pos = 0;
  66:BSP/u8g2/u8x8_selection_list.c ****     if ( u8sl->total > u8sl->visible )
  67:BSP/u8g2/u8x8_selection_list.c ****       u8sl->first_pos = u8sl->total - u8sl->visible;
  68:BSP/u8g2/u8x8_selection_list.c ****   }
  69:BSP/u8g2/u8x8_selection_list.c ****   else
  70:BSP/u8g2/u8x8_selection_list.c ****   {
  71:BSP/u8g2/u8x8_selection_list.c ****     u8sl->current_pos--;
  72:BSP/u8g2/u8x8_selection_list.c ****     if ( u8sl->first_pos > u8sl->current_pos )
  73:BSP/u8g2/u8x8_selection_list.c ****       u8sl->first_pos = u8sl->current_pos;
  74:BSP/u8g2/u8x8_selection_list.c ****   }
  75:BSP/u8g2/u8x8_selection_list.c **** }
  76:BSP/u8g2/u8x8_selection_list.c **** 
  77:BSP/u8g2/u8x8_selection_list.c **** void u8x8_DrawSelectionList(u8x8_t *u8x8, u8sl_t *u8sl, u8x8_sl_cb sl_cb, const void *aux)
  78:BSP/u8g2/u8x8_selection_list.c **** {
  79:BSP/u8g2/u8x8_selection_list.c ****   uint8_t i;
  80:BSP/u8g2/u8x8_selection_list.c ****   for( i = 0; i < u8sl->visible; i++ )
  81:BSP/u8g2/u8x8_selection_list.c ****   {
  82:BSP/u8g2/u8x8_selection_list.c ****     sl_cb(u8x8, u8sl, i+u8sl->first_pos, aux);
  83:BSP/u8g2/u8x8_selection_list.c ****   }
  84:BSP/u8g2/u8x8_selection_list.c **** }
ARM GAS  /tmp/cchcyFpm.s 			page 3


