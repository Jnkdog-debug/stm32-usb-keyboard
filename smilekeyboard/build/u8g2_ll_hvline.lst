 198:BSP/u8g2/u8g2_ll_hvline.c ****   asumption: 
 199:BSP/u8g2/u8g2_ll_hvline.c ****     all clipping done
 200:BSP/u8g2/u8g2_ll_hvline.c **** */
 201:BSP/u8g2/u8g2_ll_hvline.c **** void u8g2_ll_hvline_vertical_top_lsb(u8g2_t *u8g2, u8g2_uint_t x, u8g2_uint_t y, u8g2_uint_t len, u
 202:BSP/u8g2/u8g2_ll_hvline.c **** {
 203:BSP/u8g2/u8g2_ll_hvline.c ****   if ( dir == 0 )
 204:BSP/u8g2/u8g2_ll_hvline.c ****   {
 205:BSP/u8g2/u8g2_ll_hvline.c ****     do
 206:BSP/u8g2/u8g2_ll_hvline.c ****     {
 207:BSP/u8g2/u8g2_ll_hvline.c ****       u8g2_draw_pixel_vertical_top_lsb(u8g2, x, y);
 208:BSP/u8g2/u8g2_ll_hvline.c ****       x++;
 209:BSP/u8g2/u8g2_ll_hvline.c ****       len--;
 210:BSP/u8g2/u8g2_ll_hvline.c ****     } while( len != 0 );
 211:BSP/u8g2/u8g2_ll_hvline.c ****   }
 212:BSP/u8g2/u8g2_ll_hvline.c ****   else
 213:BSP/u8g2/u8g2_ll_hvline.c ****   {
 214:BSP/u8g2/u8g2_ll_hvline.c ****     do
 215:BSP/u8g2/u8g2_ll_hvline.c ****     {
