 161:BSP/u8g2/u8g2_ll_hvline.c **** static void u8g2_draw_pixel_vertical_top_lsb(u8g2_t *u8g2, u8g2_uint_t x, u8g2_uint_t y)
 162:BSP/u8g2/u8g2_ll_hvline.c **** {
 163:BSP/u8g2/u8g2_ll_hvline.c ****   uint16_t offset;
 164:BSP/u8g2/u8g2_ll_hvline.c ****   uint8_t *ptr;
 165:BSP/u8g2/u8g2_ll_hvline.c ****   uint8_t bit_pos, mask;
 166:BSP/u8g2/u8g2_ll_hvline.c ****   
 167:BSP/u8g2/u8g2_ll_hvline.c ****   //assert(x >= u8g2->buf_x0);
 168:BSP/u8g2/u8g2_ll_hvline.c ****   //assert(x < u8g2_GetU8x8(u8g2)->display_info->tile_width*8);
 169:BSP/u8g2/u8g2_ll_hvline.c ****   //assert(y >= u8g2->buf_y0);
 170:BSP/u8g2/u8g2_ll_hvline.c ****   //assert(y < u8g2_GetU8x8(u8g2)->display_info->tile_height*8);
 171:BSP/u8g2/u8g2_ll_hvline.c ****   
 172:BSP/u8g2/u8g2_ll_hvline.c ****   /* bytes are vertical, lsb on top (y=0), msb at bottom (y=7) */
 173:BSP/u8g2/u8g2_ll_hvline.c ****   bit_pos = y;		/* overflow truncate is ok here... */
 174:BSP/u8g2/u8g2_ll_hvline.c ****   bit_pos &= 7; 	/* ... because only the lowest 3 bits are needed */
 175:BSP/u8g2/u8g2_ll_hvline.c ****   mask = 1;
 176:BSP/u8g2/u8g2_ll_hvline.c ****   mask <<= bit_pos;
 177:BSP/u8g2/u8g2_ll_hvline.c **** 
 178:BSP/u8g2/u8g2_ll_hvline.c ****   offset = y;		/* y might be 8 or 16 bit, but we need 16 bit, so use a 16 bit variable */
 179:BSP/u8g2/u8g2_ll_hvline.c ****   offset &= ~7;
 180:BSP/u8g2/u8g2_ll_hvline.c ****   offset *= u8g2_GetU8x8(u8g2)->display_info->tile_width;
 181:BSP/u8g2/u8g2_ll_hvline.c ****   ptr = u8g2->tile_buf_ptr;
 182:BSP/u8g2/u8g2_ll_hvline.c ****   ptr += offset;
 183:BSP/u8g2/u8g2_ll_hvline.c ****   ptr += x;
 184:BSP/u8g2/u8g2_ll_hvline.c **** 
 185:BSP/u8g2/u8g2_ll_hvline.c **** 
 186:BSP/u8g2/u8g2_ll_hvline.c ****   if ( u8g2->draw_color <= 1 )
 187:BSP/u8g2/u8g2_ll_hvline.c ****     *ptr |= mask;
 188:BSP/u8g2/u8g2_ll_hvline.c ****   if ( u8g2->draw_color != 1 )
 189:BSP/u8g2/u8g2_ll_hvline.c ****     *ptr ^= mask;
 190:BSP/u8g2/u8g2_ll_hvline.c **** 
