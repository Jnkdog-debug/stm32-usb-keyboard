  69:BSP/KEYBOARD/matrix_keyboard.c **** /**
  70:BSP/KEYBOARD/matrix_keyboard.c ****   * @brief Scan the matrix keyboard
  71:BSP/KEYBOARD/matrix_keyboard.c ****   * This function should be called periodically (e.g., every 5-10ms)
  72:BSP/KEYBOARD/matrix_keyboard.c ****   * @retval None
  73:BSP/KEYBOARD/matrix_keyboard.c ****   */
  74:BSP/KEYBOARD/matrix_keyboard.c **** void Matrix_Keyboard_Scan(void)
  75:BSP/KEYBOARD/matrix_keyboard.c **** {
  76:BSP/KEYBOARD/matrix_keyboard.c ****     uint8_t col;
  77:BSP/KEYBOARD/matrix_keyboard.c ****     GPIO_PinState pin_state;
  78:BSP/KEYBOARD/matrix_keyboard.c ****     uint32_t current_time = HAL_GetTick();
  79:BSP/KEYBOARD/matrix_keyboard.c ****     
  80:BSP/KEYBOARD/matrix_keyboard.c ****     /* Scan each row */
  81:BSP/KEYBOARD/matrix_keyboard.c ****     for (uint8_t row = 0; row < KEYBOARD_ROWS; row++) {
  82:BSP/KEYBOARD/matrix_keyboard.c ****         /* Set current row to LOW (activate it), others to HIGH */
  83:BSP/KEYBOARD/matrix_keyboard.c ****         for (uint8_t i = 0; i < KEYBOARD_ROWS; i++) {
  84:BSP/KEYBOARD/matrix_keyboard.c ****             if (i == row) {
  85:BSP/KEYBOARD/matrix_keyboard.c ****                 HAL_GPIO_WritePin(ROW_PORT, row_pins[i], GPIO_PIN_RESET);  // LOW = active
  86:BSP/KEYBOARD/matrix_keyboard.c ****             } else {
  87:BSP/KEYBOARD/matrix_keyboard.c ****                 HAL_GPIO_WritePin(ROW_PORT, row_pins[i], GPIO_PIN_SET);    // HIGH = inactive
  88:BSP/KEYBOARD/matrix_keyboard.c ****             }
  89:BSP/KEYBOARD/matrix_keyboard.c ****         }
  90:BSP/KEYBOARD/matrix_keyboard.c ****         
  91:BSP/KEYBOARD/matrix_keyboard.c ****         /* Small delay for signal stabilization */
  92:BSP/KEYBOARD/matrix_keyboard.c ****         for (volatile uint32_t i = 0; i < 100; i++);
  93:BSP/KEYBOARD/matrix_keyboard.c ****         
  94:BSP/KEYBOARD/matrix_keyboard.c ****         /* Read each column */
  95:BSP/KEYBOARD/matrix_keyboard.c ****         for (col = 0; col < KEYBOARD_COLS; col++) {
  96:BSP/KEYBOARD/matrix_keyboard.c ****             pin_state = HAL_GPIO_ReadPin(COL_PORT, col_pins[col]);
  97:BSP/KEYBOARD/matrix_keyboard.c ****             
  98:BSP/KEYBOARD/matrix_keyboard.c ****             /* With pull-up: GPIO_PIN_RESET (0) = pressed, GPIO_PIN_SET (1) = not pressed */
  99:BSP/KEYBOARD/matrix_keyboard.c ****             uint8_t current_state = (pin_state == GPIO_PIN_RESET) ? 1 : 0;
 100:BSP/KEYBOARD/matrix_keyboard.c ****             
ARM GAS  /tmp/cc08HJeM.s 			page 6


 101:BSP/KEYBOARD/matrix_keyboard.c ****             /* Debounce logic */
 102:BSP/KEYBOARD/matrix_keyboard.c ****             if (current_state != key_state[row][col]) {
 103:BSP/KEYBOARD/matrix_keyboard.c ****                 /* State changed, start debounce timer */
 104:BSP/KEYBOARD/matrix_keyboard.c ****                 if (debounce_timer[row][col] == 0) {
 105:BSP/KEYBOARD/matrix_keyboard.c ****                     debounce_timer[row][col] = current_time;
 106:BSP/KEYBOARD/matrix_keyboard.c ****                 }
 107:BSP/KEYBOARD/matrix_keyboard.c ****                 
 108:BSP/KEYBOARD/matrix_keyboard.c ****                 /* Check if debounce time has passed */
 109:BSP/KEYBOARD/matrix_keyboard.c ****                 if ((current_time - debounce_timer[row][col]) >= DEBOUNCE_TIME) {
 110:BSP/KEYBOARD/matrix_keyboard.c ****                     /* State is stable, update key state */
 111:BSP/KEYBOARD/matrix_keyboard.c ****                     key_state_last[row][col] = key_state[row][col];
 112:BSP/KEYBOARD/matrix_keyboard.c ****                     key_state[row][col] = current_state;
 113:BSP/KEYBOARD/matrix_keyboard.c ****                     debounce_timer[row][col] = 0;
 114:BSP/KEYBOARD/matrix_keyboard.c ****                     
 115:BSP/KEYBOARD/matrix_keyboard.c ****                     /* Call callback if state changed */
 116:BSP/KEYBOARD/matrix_keyboard.c ****                     if (key_state[row][col] != key_state_last[row][col]) {
 117:BSP/KEYBOARD/matrix_keyboard.c ****                         uint8_t key_code = key_map[row][col];
 118:BSP/KEYBOARD/matrix_keyboard.c ****                         Matrix_Key_Callback(key_code, key_state[row][col]);
 119:BSP/KEYBOARD/matrix_keyboard.c ****                     }
 120:BSP/KEYBOARD/matrix_keyboard.c ****                 }
 121:BSP/KEYBOARD/matrix_keyboard.c ****             } else {
 122:BSP/KEYBOARD/matrix_keyboard.c ****                 /* State stable, reset debounce timer */
 123:BSP/KEYBOARD/matrix_keyboard.c ****                 debounce_timer[row][col] = 0;
 124:BSP/KEYBOARD/matrix_keyboard.c ****             }
 125:BSP/KEYBOARD/matrix_keyboard.c ****         }
 126:BSP/KEYBOARD/matrix_keyboard.c ****     }
 127:BSP/KEYBOARD/matrix_keyboard.c ****     
 128:BSP/KEYBOARD/matrix_keyboard.c ****     /* Set all rows back to HIGH when done */
 129:BSP/KEYBOARD/matrix_keyboard.c ****     for (uint8_t i = 0; i < KEYBOARD_ROWS; i++) {
 130:BSP/KEYBOARD/matrix_keyboard.c ****         HAL_GPIO_WritePin(ROW_PORT, row_pins[i], GPIO_PIN_SET);
 131:BSP/KEYBOARD/matrix_keyboard.c ****     }
 132:BSP/KEYBOARD/matrix_keyboard.c **** }
