  51:BSP/u8g2/u8g2_intersection.c **** /*
  52:BSP/u8g2/u8g2_intersection.c ****   intersection assumptions:
  53:BSP/u8g2/u8g2_intersection.c ****     a1 <= a2 is always true    
  54:BSP/u8g2/u8g2_intersection.c ****     
  55:BSP/u8g2/u8g2_intersection.c ****     minimized version
  56:BSP/u8g2/u8g2_intersection.c ****     ---1----0 1             b1 <= a2 && b1 > b2
  57:BSP/u8g2/u8g2_intersection.c ****     -----1--0 1             b2 >= a1 && b1 > b2
  58:BSP/u8g2/u8g2_intersection.c ****     ---1-1--- 1             b1 <= a2 && b2 >= a1
  59:BSP/u8g2/u8g2_intersection.c ****   */
  60:BSP/u8g2/u8g2_intersection.c **** 
  61:BSP/u8g2/u8g2_intersection.c **** 
  62:BSP/u8g2/u8g2_intersection.c **** /*
  63:BSP/u8g2/u8g2_intersection.c ****   calculate the intersection between a0/a1 and v0/v1
  64:BSP/u8g2/u8g2_intersection.c ****   The intersection check returns one if the range of a0/a1 has an intersection with v0/v1.
  65:BSP/u8g2/u8g2_intersection.c ****   The intersection check includes the boundary values v1 and a1.
  66:BSP/u8g2/u8g2_intersection.c **** 
  67:BSP/u8g2/u8g2_intersection.c ****   The following asserts will succeed:
  68:BSP/u8g2/u8g2_intersection.c ****     assert( u8g2_is_intersection_decision_tree(4, 6, 7, 9) == 0 );
  69:BSP/u8g2/u8g2_intersection.c ****     assert( u8g2_is_intersection_decision_tree(4, 6, 6, 9) != 0 );
  70:BSP/u8g2/u8g2_intersection.c ****     assert( u8g2_is_intersection_decision_tree(6, 9, 4, 6) != 0 );
  71:BSP/u8g2/u8g2_intersection.c ****     assert( u8g2_is_intersection_decision_tree(7, 9, 4, 6) == 0 );  
  72:BSP/u8g2/u8g2_intersection.c **** */
  73:BSP/u8g2/u8g2_intersection.c **** 
  74:BSP/u8g2/u8g2_intersection.c **** //static uint8_t U8G2_ALWAYS_INLINE u8g2_is_intersection_decision_tree(u8g_uint_t a0, u8g_uint_t a1
  75:BSP/u8g2/u8g2_intersection.c **** static uint8_t u8g2_is_intersection_decision_tree(u8g2_uint_t a0, u8g2_uint_t a1, u8g2_uint_t v0, u
  76:BSP/u8g2/u8g2_intersection.c **** {
  77:BSP/u8g2/u8g2_intersection.c ****   if ( v0 <= a1 )
  78:BSP/u8g2/u8g2_intersection.c ****   {
  79:BSP/u8g2/u8g2_intersection.c ****     if ( v1 >= a0 )
  80:BSP/u8g2/u8g2_intersection.c ****     {
  81:BSP/u8g2/u8g2_intersection.c ****       return 1;
  82:BSP/u8g2/u8g2_intersection.c ****     }
  83:BSP/u8g2/u8g2_intersection.c ****     else
  84:BSP/u8g2/u8g2_intersection.c ****     {
  85:BSP/u8g2/u8g2_intersection.c ****       if ( v0 > v1 )
  86:BSP/u8g2/u8g2_intersection.c ****       {
  87:BSP/u8g2/u8g2_intersection.c **** 	return 1;
  88:BSP/u8g2/u8g2_intersection.c ****       }
