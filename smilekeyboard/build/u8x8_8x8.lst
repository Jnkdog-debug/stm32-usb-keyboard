 129:BSP/u8g2/u8x8_8x8.c **** /*
 130:BSP/u8g2/u8x8_8x8.c ****   Source: http://graphics.stanford.edu/~seander/bithacks.html
 131:BSP/u8g2/u8x8_8x8.c **** 	Section: Interleave bits by Binary Magic Numbers 
 132:BSP/u8g2/u8x8_8x8.c ****    Original codes is here:
 133:BSP/u8g2/u8x8_8x8.c **** 		static const unsigned int B[] = {0x55555555, 0x33333333, 0x0F0F0F0F, 0x00FF00FF};
 134:BSP/u8g2/u8x8_8x8.c **** 		static const unsigned int S[] = {1, 2, 4, 8};
 135:BSP/u8g2/u8x8_8x8.c **** 
 136:BSP/u8g2/u8x8_8x8.c **** 		unsigned int x; // Interleave lower 16 bits of x and y, so the bits of x
 137:BSP/u8g2/u8x8_8x8.c **** 		unsigned int y; // are in the even positions and bits from y in the odd;
 138:BSP/u8g2/u8x8_8x8.c **** 		unsigned int z; // z gets the resulting 32-bit Morton Number.  
 139:BSP/u8g2/u8x8_8x8.c **** 				// x and y must initially be less than 65536.
 140:BSP/u8g2/u8x8_8x8.c **** 
 141:BSP/u8g2/u8x8_8x8.c **** 		x = (x | (x << S[3])) & B[3];
 142:BSP/u8g2/u8x8_8x8.c **** 		x = (x | (x << S[2])) & B[2];
 143:BSP/u8g2/u8x8_8x8.c **** 		x = (x | (x << S[1])) & B[1];
 144:BSP/u8g2/u8x8_8x8.c **** 		x = (x | (x << S[0])) & B[0];
 145:BSP/u8g2/u8x8_8x8.c **** 
 146:BSP/u8g2/u8x8_8x8.c **** 		y = (y | (y << S[3])) & B[3];
 147:BSP/u8g2/u8x8_8x8.c **** 		y = (y | (y << S[2])) & B[2];
 148:BSP/u8g2/u8x8_8x8.c **** 		y = (y | (y << S[1])) & B[1];
 149:BSP/u8g2/u8x8_8x8.c **** 		y = (y | (y << S[0])) & B[0];
 150:BSP/u8g2/u8x8_8x8.c **** 
 151:BSP/u8g2/u8x8_8x8.c **** 		z = x | (y << 1);
 152:BSP/u8g2/u8x8_8x8.c **** */
 153:BSP/u8g2/u8x8_8x8.c **** uint16_t u8x8_upscale_byte(uint8_t x) 
 154:BSP/u8g2/u8x8_8x8.c **** {
 155:BSP/u8g2/u8x8_8x8.c **** 	uint16_t y = x;
 156:BSP/u8g2/u8x8_8x8.c **** 	y |= (y << 4);		// x = (x | (x << S[2])) & B[2];
 157:BSP/u8g2/u8x8_8x8.c **** 	y &= 0x0f0f;
 158:BSP/u8g2/u8x8_8x8.c **** 	y |= (y << 2);		// x = (x | (x << S[1])) & B[1];
 159:BSP/u8g2/u8x8_8x8.c **** 	y &= 0x3333;
 160:BSP/u8g2/u8x8_8x8.c **** 	y |= (y << 1);		// x = (x | (x << S[0])) & B[0];
 161:BSP/u8g2/u8x8_8x8.c **** 	y &= 0x5555;
 162:BSP/u8g2/u8x8_8x8.c ****   
 163:BSP/u8g2/u8x8_8x8.c **** 	y |= (y << 1);		// z = x | (y << 1);
 164:BSP/u8g2/u8x8_8x8.c **** 	return y;
 165:BSP/u8g2/u8x8_8x8.c **** }
