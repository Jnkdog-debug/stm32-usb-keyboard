 340:BSP/OLED/OLED.c **** 
 341:BSP/OLED/OLED.c ****     OLED_WriteCommand(0xD9); // 设置预充电周期
 342:BSP/OLED/OLED.c ****     OLED_WriteCommand(0xF1);
 343:BSP/OLED/OLED.c **** 
 344:BSP/OLED/OLED.c ****     OLED_WriteCommand(0xDB); // 设置VCOMH取消选择级别
