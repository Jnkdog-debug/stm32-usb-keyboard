 708:BSP/OLED/OLED.c **** /**
 709:BSP/OLED/OLED.c ****  * @brief OLED显示十六进制数字（十六进制，正整数）
 710:BSP/OLED/OLED.c ****  * @param X 指定数字左上角的横坐标，范围：0~127
 711:BSP/OLED/OLED.c ****  * @param Y 指定数字左上角的纵坐标，范围：0~63
 712:BSP/OLED/OLED.c ****  * @param Number 指定要显示的数字，范围：0x00000000~0xFFFFFFFF
 713:BSP/OLED/OLED.c ****  * @param Length 指定数字的长度，范围：0~8
 714:BSP/OLED/OLED.c ****  * @param FontSize 指定字体大小
 715:BSP/OLED/OLED.c ****  *           范围：OLED_8X16		宽8像素，高16像素
 716:BSP/OLED/OLED.c ****  *                 OLED_6X8		宽6像素，高8像素
 717:BSP/OLED/OLED.c ****  * @return 无
 718:BSP/OLED/OLED.c ****  * @note 调用此函数后，要想真正地呈现在屏幕上，还需调用更新函数
 719:BSP/OLED/OLED.c ****  */
 720:BSP/OLED/OLED.c **** void OLED_ShowHexNum(uint8_t X, uint8_t Y, uint32_t Number, uint8_t Length, uint8_t FontSize)
 721:BSP/OLED/OLED.c **** {
 722:BSP/OLED/OLED.c ****     uint8_t i, SingleNumber;
 723:BSP/OLED/OLED.c ****     for (i = 0; i < Length; i++) // 遍历数字的每一位
 724:BSP/OLED/OLED.c ****     {
 725:BSP/OLED/OLED.c ****         /*以十六进制提取数字的每一位*/
 726:BSP/OLED/OLED.c ****         SingleNumber = Number / OLED_Pow(16, Length - i - 1) % 16;
 727:BSP/OLED/OLED.c **** 
 728:BSP/OLED/OLED.c ****         if (SingleNumber < 10) // 单个数字小于10
 729:BSP/OLED/OLED.c ****         {
 730:BSP/OLED/OLED.c ****             /*调用OLED_ShowChar函数，显示此数字*/
 731:BSP/OLED/OLED.c ****             /*+ '0' 可将数字转换为字符格式*/
 732:BSP/OLED/OLED.c ****             OLED_ShowChar(X + i * FontSize, Y, SingleNumber + '0', FontSize);
 733:BSP/OLED/OLED.c ****         } else // 单个数字大于10
 734:BSP/OLED/OLED.c ****         {
 735:BSP/OLED/OLED.c ****             /*调用OLED_ShowChar函数，显示此数字*/
 736:BSP/OLED/OLED.c ****             /*+ 'A' 可将数字转换为从A开始的十六进制字符*/
 737:BSP/OLED/OLED.c ****             OLED_ShowChar(X + i * FontSize, Y, SingleNumber - 10 + 'A', FontSize);
 738:BSP/OLED/OLED.c ****         }
 739:BSP/OLED/OLED.c ****     }
 740:BSP/OLED/OLED.c **** }
