 124:BSP/OLED/OLED.c **** /**
 125:BSP/OLED/OLED.c ****  * @brief 向 OLED_SCL 写高低电平
 126:BSP/OLED/OLED.c ****  * 根据 BitValue 的值，将 OLED_SCL 置高电平或低电平。
 127:BSP/OLED/OLED.c ****  * @param BitValue 位值，0 或 1
 128:BSP/OLED/OLED.c ****  */
 129:BSP/OLED/OLED.c **** void OLED_W_SCL(uint8_t BitValue)
 130:BSP/OLED/OLED.c **** {
 131:BSP/OLED/OLED.c **** 	/*根据BitValue的值，将SCL置高电平或者低电平*/
 132:BSP/OLED/OLED.c **** 	HAL_GPIO_WritePin(OLED_SCL_GPIO_Port, OLED_SCL, (GPIO_PinState)BitValue);
 133:BSP/OLED/OLED.c **** 	/*如果单片机速度过快，可在此添加适量延时，以避免超出I2C通信的最大速
 134:BSP/OLED/OLED.c ****     for (volatile uint16_t i = 0; i < Delay_time; i++){
 135:BSP/OLED/OLED.c ****         //for (uint16_t j = 0; j < 10; j++);
 136:BSP/OLED/OLED.c ****     }
 137:BSP/OLED/OLED.c **** }
 138:BSP/OLED/OLED.c **** 
 139:BSP/OLED/OLED.c **** /**
 140:BSP/OLED/OLED.c ****   * @brief OLED写SDA高低电平
 141:BSP/OLED/OLED.c ****   * @param 要写入SDA的电平值，范围：0/1
 142:BSP/OLED/OLED.c ****   * @return 无
 143:BSP/OLED/OLED.c ****   * @note 当上层函数需要写SDA时，此函数会被调用
 144:BSP/OLED/OLED.c ****   *           用户需要根据参数传入的值，将SDA置为高电平或者低电平
 145:BSP/OLED/OLED.c ****   *           当参数传入0时，置SDA为低电平，当参数传入1时，置SDA为高电平
 146:BSP/OLED/OLED.c ****   */
ARM GAS  /tmp/ccFRbyPM.s 			page 4


 147:BSP/OLED/OLED.c **** void OLED_W_SDA(uint8_t BitValue)
 148:BSP/OLED/OLED.c **** {
 149:BSP/OLED/OLED.c **** 	/*根据BitValue的值，将SDA置高电平或者低电平*/
 150:BSP/OLED/OLED.c **** 	HAL_GPIO_WritePin(OLED_SDA_GPIO_Port, OLED_SDA, (GPIO_PinState)BitValue);
 151:BSP/OLED/OLED.c **** 	/*如果单片机速度过快，可在此添加适量延时，以避免超出I2C通信的最大速
