  38:BSP/u8g2/u8g2_cleardisplay.c **** /* This is done with u8g2 picture loop, because we can not use the u8x8 function in all cases */
  39:BSP/u8g2/u8g2_cleardisplay.c **** void u8g2_ClearDisplay(u8g2_t *u8g2)
  40:BSP/u8g2/u8g2_cleardisplay.c **** {
