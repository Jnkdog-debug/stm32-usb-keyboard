  36:BSP/u8g2/u8x8_cad.c **** 
  37:BSP/u8g2/u8x8_cad.c ****   The following sequence must be used for any data, which is set to the display:
  38:BSP/u8g2/u8x8_cad.c ****   
  39:BSP/u8g2/u8x8_cad.c ****   
  40:BSP/u8g2/u8x8_cad.c ****   uint8_t u8x8_cad_StartTransfer(u8x8_t *u8x8)
  41:BSP/u8g2/u8x8_cad.c **** 
  42:BSP/u8g2/u8x8_cad.c ****   any of the following calls
  43:BSP/u8g2/u8x8_cad.c ****     uint8_t u8x8_cad_SendCmd(u8x8_t *u8x8, uint8_t cmd)
  44:BSP/u8g2/u8x8_cad.c ****     uint8_t u8x8_cad_SendArg(u8x8_t *u8x8, uint8_t arg)
  45:BSP/u8g2/u8x8_cad.c ****     uint8_t u8x8_cad_SendData(u8x8_t *u8x8, uint8_t cnt, uint8_t *data)
  46:BSP/u8g2/u8x8_cad.c ****   
  47:BSP/u8g2/u8x8_cad.c ****   uint8_t u8x8_cad_EndTransfer(u8x8_t *u8x8)
  48:BSP/u8g2/u8x8_cad.c **** 
  49:BSP/u8g2/u8x8_cad.c **** 
  50:BSP/u8g2/u8x8_cad.c **** 
  51:BSP/u8g2/u8x8_cad.c **** */
  52:BSP/u8g2/u8x8_cad.c **** /*
  53:BSP/u8g2/u8x8_cad.c **** uint8_t u8x8_cad_template(u8x8_t *u8x8, uint8_t msg, uint16_t arg_int, void *arg_ptr)
  54:BSP/u8g2/u8x8_cad.c **** {
  55:BSP/u8g2/u8x8_cad.c ****   uint8_t i;
  56:BSP/u8g2/u8x8_cad.c ****   
  57:BSP/u8g2/u8x8_cad.c ****   switch(msg)
  58:BSP/u8g2/u8x8_cad.c ****   {
  59:BSP/u8g2/u8x8_cad.c ****     case U8X8_MSG_CAD_SEND_CMD:
  60:BSP/u8g2/u8x8_cad.c ****       u8x8_mcd_byte_SetDC(mcd->next, 1);
  61:BSP/u8g2/u8x8_cad.c ****       u8x8_mcd_byte_Send(mcd->next, arg_int);
  62:BSP/u8g2/u8x8_cad.c ****       break;
  63:BSP/u8g2/u8x8_cad.c ****     case U8X8_MSG_CAD_SEND_ARG:
  64:BSP/u8g2/u8x8_cad.c ****       u8x8_mcd_byte_SetDC(mcd->next, 1);
  65:BSP/u8g2/u8x8_cad.c ****       u8x8_mcd_byte_Send(mcd->next, arg_int);
  66:BSP/u8g2/u8x8_cad.c ****       break;
  67:BSP/u8g2/u8x8_cad.c ****     case U8X8_MSG_CAD_SEND_DATA:
  68:BSP/u8g2/u8x8_cad.c ****       u8x8_mcd_byte_SetDC(mcd->next, 0);
  69:BSP/u8g2/u8x8_cad.c ****       for( i = 0; i < 8; i++ )
  70:BSP/u8g2/u8x8_cad.c **** 	u8x8_mcd_byte_Send(mcd->next, ((uint8_t *)arg_ptr)[i]);
  71:BSP/u8g2/u8x8_cad.c ****       break;
  72:BSP/u8g2/u8x8_cad.c ****     case U8X8_MSG_CAD_RESET:
  73:BSP/u8g2/u8x8_cad.c ****       return mcd->next->cb(mcd->next, msg, arg_int, arg_ptr);
  74:BSP/u8g2/u8x8_cad.c ****     case U8X8_MSG_CAD_START_TRANSFER:
  75:BSP/u8g2/u8x8_cad.c ****       return mcd->next->cb(mcd->next, msg, arg_int, arg_ptr);
  76:BSP/u8g2/u8x8_cad.c ****     case U8X8_MSG_CAD_END_TRANSFER:
  77:BSP/u8g2/u8x8_cad.c ****       return mcd->next->cb(mcd->next, msg, arg_int, arg_ptr);
  78:BSP/u8g2/u8x8_cad.c ****     default:
  79:BSP/u8g2/u8x8_cad.c ****       break;
  80:BSP/u8g2/u8x8_cad.c ****   }
  81:BSP/u8g2/u8x8_cad.c ****   return 1;
  82:BSP/u8g2/u8x8_cad.c **** }
  83:BSP/u8g2/u8x8_cad.c **** 
  84:BSP/u8g2/u8x8_cad.c **** */
  85:BSP/u8g2/u8x8_cad.c **** 
  86:BSP/u8g2/u8x8_cad.c **** #include "u8x8.h"
  87:BSP/u8g2/u8x8_cad.c **** 
  88:BSP/u8g2/u8x8_cad.c **** uint8_t u8x8_cad_SendCmd(u8x8_t *u8x8, uint8_t cmd)
  89:BSP/u8g2/u8x8_cad.c **** {
ARM GAS  /tmp/cczpVMPO.s 			page 3


  90:BSP/u8g2/u8x8_cad.c ****   return u8x8->cad_cb(u8x8, U8X8_MSG_CAD_SEND_CMD, cmd, NULL);
  91:BSP/u8g2/u8x8_cad.c **** }
  92:BSP/u8g2/u8x8_cad.c **** 
  93:BSP/u8g2/u8x8_cad.c **** uint8_t u8x8_cad_SendArg(u8x8_t *u8x8, uint8_t arg)
  94:BSP/u8g2/u8x8_cad.c **** {
  95:BSP/u8g2/u8x8_cad.c ****   return u8x8->cad_cb(u8x8, U8X8_MSG_CAD_SEND_ARG, arg, NULL);
  96:BSP/u8g2/u8x8_cad.c **** }
  97:BSP/u8g2/u8x8_cad.c **** 
  98:BSP/u8g2/u8x8_cad.c **** uint8_t u8x8_cad_SendMultipleArg(u8x8_t *u8x8, uint8_t cnt, uint8_t arg)
  99:BSP/u8g2/u8x8_cad.c **** {
 100:BSP/u8g2/u8x8_cad.c ****   while( cnt > 0 )
 101:BSP/u8g2/u8x8_cad.c ****   {
 102:BSP/u8g2/u8x8_cad.c ****     u8x8->cad_cb(u8x8, U8X8_MSG_CAD_SEND_ARG, arg, NULL);
 103:BSP/u8g2/u8x8_cad.c ****     cnt--;
 104:BSP/u8g2/u8x8_cad.c ****   }
 105:BSP/u8g2/u8x8_cad.c ****   return 1;
 106:BSP/u8g2/u8x8_cad.c **** }
 107:BSP/u8g2/u8x8_cad.c **** 
 108:BSP/u8g2/u8x8_cad.c **** uint8_t u8x8_cad_SendData(u8x8_t *u8x8, uint8_t cnt, uint8_t *data)
 109:BSP/u8g2/u8x8_cad.c **** {
 110:BSP/u8g2/u8x8_cad.c ****   return u8x8->cad_cb(u8x8, U8X8_MSG_CAD_SEND_DATA, cnt, data);
 111:BSP/u8g2/u8x8_cad.c **** }
 112:BSP/u8g2/u8x8_cad.c **** 
 113:BSP/u8g2/u8x8_cad.c **** uint8_t u8x8_cad_StartTransfer(u8x8_t *u8x8)
 114:BSP/u8g2/u8x8_cad.c **** {
 115:BSP/u8g2/u8x8_cad.c ****   return u8x8->cad_cb(u8x8, U8X8_MSG_CAD_START_TRANSFER, 0, NULL);
 116:BSP/u8g2/u8x8_cad.c **** }
 117:BSP/u8g2/u8x8_cad.c **** 
 118:BSP/u8g2/u8x8_cad.c **** uint8_t u8x8_cad_EndTransfer(u8x8_t *u8x8)
 119:BSP/u8g2/u8x8_cad.c **** {
 120:BSP/u8g2/u8x8_cad.c ****   return u8x8->cad_cb(u8x8, U8X8_MSG_CAD_END_TRANSFER, 0, NULL);
 121:BSP/u8g2/u8x8_cad.c **** }
 122:BSP/u8g2/u8x8_cad.c **** 
 123:BSP/u8g2/u8x8_cad.c **** void u8x8_cad_vsendf(u8x8_t * u8x8, const char *fmt, va_list va)
 124:BSP/u8g2/u8x8_cad.c **** {
 125:BSP/u8g2/u8x8_cad.c ****   uint8_t d;
 126:BSP/u8g2/u8x8_cad.c ****   u8x8_cad_StartTransfer(u8x8);
 127:BSP/u8g2/u8x8_cad.c ****   while( *fmt != '\0' )
 128:BSP/u8g2/u8x8_cad.c ****   {
 129:BSP/u8g2/u8x8_cad.c ****     d = (uint8_t)va_arg(va, int);
 130:BSP/u8g2/u8x8_cad.c ****     switch(*fmt)
 131:BSP/u8g2/u8x8_cad.c ****     {
 132:BSP/u8g2/u8x8_cad.c ****       case 'a':  u8x8_cad_SendArg(u8x8, d); break;
 133:BSP/u8g2/u8x8_cad.c ****       case 'c':  u8x8_cad_SendCmd(u8x8, d); break;
 134:BSP/u8g2/u8x8_cad.c ****       case 'd':  u8x8_cad_SendData(u8x8, 1, &d); break;
 135:BSP/u8g2/u8x8_cad.c ****     }
 136:BSP/u8g2/u8x8_cad.c ****     fmt++;
 137:BSP/u8g2/u8x8_cad.c ****   }
 138:BSP/u8g2/u8x8_cad.c ****   u8x8_cad_EndTransfer(u8x8);
 139:BSP/u8g2/u8x8_cad.c **** }
 140:BSP/u8g2/u8x8_cad.c **** 
 141:BSP/u8g2/u8x8_cad.c **** void u8x8_SendF(u8x8_t * u8x8, const char *fmt, ...)
 142:BSP/u8g2/u8x8_cad.c **** {
 143:BSP/u8g2/u8x8_cad.c ****   va_list va;
 144:BSP/u8g2/u8x8_cad.c ****   va_start(va, fmt);
 145:BSP/u8g2/u8x8_cad.c ****   u8x8_cad_vsendf(u8x8, fmt, va);
 146:BSP/u8g2/u8x8_cad.c ****   va_end(va);
ARM GAS  /tmp/cczpVMPO.s 			page 4


 147:BSP/u8g2/u8x8_cad.c **** }
 148:BSP/u8g2/u8x8_cad.c **** 
 149:BSP/u8g2/u8x8_cad.c **** /*
 150:BSP/u8g2/u8x8_cad.c ****   21 c		send command c
 151:BSP/u8g2/u8x8_cad.c ****   22 a		send arg a
 152:BSP/u8g2/u8x8_cad.c ****   23 d		send data d
 153:BSP/u8g2/u8x8_cad.c ****   24			CS on
 154:BSP/u8g2/u8x8_cad.c ****   25			CS off
 155:BSP/u8g2/u8x8_cad.c ****   254 milli	delay by milliseconds
 156:BSP/u8g2/u8x8_cad.c ****   255		end of sequence
 157:BSP/u8g2/u8x8_cad.c **** */
 158:BSP/u8g2/u8x8_cad.c **** 
 159:BSP/u8g2/u8x8_cad.c **** void u8x8_cad_SendSequence(u8x8_t *u8x8, uint8_t const *data)
 160:BSP/u8g2/u8x8_cad.c **** {
 161:BSP/u8g2/u8x8_cad.c ****   uint8_t cmd;
 162:BSP/u8g2/u8x8_cad.c ****   uint8_t v;
 163:BSP/u8g2/u8x8_cad.c **** 
 164:BSP/u8g2/u8x8_cad.c ****   for(;;)
 165:BSP/u8g2/u8x8_cad.c ****   {
 166:BSP/u8g2/u8x8_cad.c ****     cmd = *data;
 167:BSP/u8g2/u8x8_cad.c ****     data++;
 168:BSP/u8g2/u8x8_cad.c ****     switch( cmd )
 169:BSP/u8g2/u8x8_cad.c ****     {
 170:BSP/u8g2/u8x8_cad.c ****       case U8X8_MSG_CAD_SEND_CMD:
 171:BSP/u8g2/u8x8_cad.c ****       case U8X8_MSG_CAD_SEND_ARG:
 172:BSP/u8g2/u8x8_cad.c **** 	  v = *data;
 173:BSP/u8g2/u8x8_cad.c **** 	  u8x8->cad_cb(u8x8, cmd, v, NULL);
 174:BSP/u8g2/u8x8_cad.c **** 	  data++;
 175:BSP/u8g2/u8x8_cad.c **** 	  break;
 176:BSP/u8g2/u8x8_cad.c ****       case U8X8_MSG_CAD_SEND_DATA:
 177:BSP/u8g2/u8x8_cad.c **** 	  v = *data;
 178:BSP/u8g2/u8x8_cad.c **** 	  u8x8_cad_SendData(u8x8, 1, &v);
 179:BSP/u8g2/u8x8_cad.c **** 	  data++;
 180:BSP/u8g2/u8x8_cad.c **** 	  break;
 181:BSP/u8g2/u8x8_cad.c ****       case U8X8_MSG_CAD_START_TRANSFER:
 182:BSP/u8g2/u8x8_cad.c ****       case U8X8_MSG_CAD_END_TRANSFER:
 183:BSP/u8g2/u8x8_cad.c **** 	  u8x8->cad_cb(u8x8, cmd, 0, NULL);
 184:BSP/u8g2/u8x8_cad.c **** 	  break;
 185:BSP/u8g2/u8x8_cad.c ****       case 0x0fe:
 186:BSP/u8g2/u8x8_cad.c **** 	  v = *data;
 187:BSP/u8g2/u8x8_cad.c **** 	  u8x8_gpio_Delay(u8x8, U8X8_MSG_DELAY_MILLI, v);	    
 188:BSP/u8g2/u8x8_cad.c **** 	  data++;
 189:BSP/u8g2/u8x8_cad.c **** 	  break;
 190:BSP/u8g2/u8x8_cad.c ****       default:
 191:BSP/u8g2/u8x8_cad.c **** 	return;
 192:BSP/u8g2/u8x8_cad.c ****     }
 193:BSP/u8g2/u8x8_cad.c ****   }
 194:BSP/u8g2/u8x8_cad.c **** }
 195:BSP/u8g2/u8x8_cad.c **** 
 196:BSP/u8g2/u8x8_cad.c **** 
 197:BSP/u8g2/u8x8_cad.c **** uint8_t u8x8_cad_empty(u8x8_t *u8x8, uint8_t msg, uint8_t arg_int, void *arg_ptr)
 198:BSP/u8g2/u8x8_cad.c **** {
 199:BSP/u8g2/u8x8_cad.c ****   switch(msg)
 200:BSP/u8g2/u8x8_cad.c ****   {
 201:BSP/u8g2/u8x8_cad.c ****     case U8X8_MSG_CAD_SEND_CMD:
 202:BSP/u8g2/u8x8_cad.c ****       u8x8_byte_SendByte(u8x8, arg_int);
 203:BSP/u8g2/u8x8_cad.c ****       break;
ARM GAS  /tmp/cczpVMPO.s 			page 5


 204:BSP/u8g2/u8x8_cad.c ****     case U8X8_MSG_CAD_SEND_ARG:
 205:BSP/u8g2/u8x8_cad.c ****       u8x8_byte_SendByte(u8x8, arg_int);
 206:BSP/u8g2/u8x8_cad.c ****       break;
 207:BSP/u8g2/u8x8_cad.c ****     case U8X8_MSG_CAD_SEND_DATA:
 208:BSP/u8g2/u8x8_cad.c ****     case U8X8_MSG_CAD_INIT:
 209:BSP/u8g2/u8x8_cad.c ****     case U8X8_MSG_CAD_START_TRANSFER:
 210:BSP/u8g2/u8x8_cad.c ****     case U8X8_MSG_CAD_END_TRANSFER:
 211:BSP/u8g2/u8x8_cad.c ****       return u8x8->byte_cb(u8x8, msg, arg_int, arg_ptr);
 212:BSP/u8g2/u8x8_cad.c ****     default:
 213:BSP/u8g2/u8x8_cad.c ****       return 0;
 214:BSP/u8g2/u8x8_cad.c ****   }
 215:BSP/u8g2/u8x8_cad.c ****   return 1;
 216:BSP/u8g2/u8x8_cad.c **** }
 217:BSP/u8g2/u8x8_cad.c **** 
 218:BSP/u8g2/u8x8_cad.c **** 
 219:BSP/u8g2/u8x8_cad.c **** /*
 220:BSP/u8g2/u8x8_cad.c ****   convert to bytes by using 
 221:BSP/u8g2/u8x8_cad.c ****     dc = 1 for commands and args and
 222:BSP/u8g2/u8x8_cad.c ****     dc = 0 for data
 223:BSP/u8g2/u8x8_cad.c **** */
 224:BSP/u8g2/u8x8_cad.c **** uint8_t u8x8_cad_110(u8x8_t *u8x8, uint8_t msg, uint8_t arg_int, void *arg_ptr)
 225:BSP/u8g2/u8x8_cad.c **** {
 226:BSP/u8g2/u8x8_cad.c ****   switch(msg)
 227:BSP/u8g2/u8x8_cad.c ****   {
 228:BSP/u8g2/u8x8_cad.c ****     case U8X8_MSG_CAD_SEND_CMD:
 229:BSP/u8g2/u8x8_cad.c ****       u8x8_byte_SetDC(u8x8, 1);
 230:BSP/u8g2/u8x8_cad.c ****       u8x8_byte_SendByte(u8x8, arg_int);
 231:BSP/u8g2/u8x8_cad.c ****       break;
 232:BSP/u8g2/u8x8_cad.c ****     case U8X8_MSG_CAD_SEND_ARG:
 233:BSP/u8g2/u8x8_cad.c ****       u8x8_byte_SetDC(u8x8, 1);
 234:BSP/u8g2/u8x8_cad.c ****       u8x8_byte_SendByte(u8x8, arg_int);
 235:BSP/u8g2/u8x8_cad.c ****       break;
 236:BSP/u8g2/u8x8_cad.c ****     case U8X8_MSG_CAD_SEND_DATA:
 237:BSP/u8g2/u8x8_cad.c ****       u8x8_byte_SetDC(u8x8, 0);
 238:BSP/u8g2/u8x8_cad.c ****       //u8x8_byte_SendBytes(u8x8, arg_int, arg_ptr);
 239:BSP/u8g2/u8x8_cad.c ****       //break;
