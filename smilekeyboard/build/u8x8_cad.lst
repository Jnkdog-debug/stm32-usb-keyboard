 628:BSP/u8g2/u8x8_cad.c ****       /* the FeatherWing OLED with the 32u4 transfer of long byte */
 629:BSP/u8g2/u8x8_cad.c ****       /* streams was not possible. This is broken down to */
 630:BSP/u8g2/u8x8_cad.c ****       /* smaller streams, 32 seems to be the limit... */
 631:BSP/u8g2/u8x8_cad.c ****       /* I guess this is related to the size of the Wire buffers in Arduino */
 632:BSP/u8g2/u8x8_cad.c ****       /* Unfortunately, this can not be handled in the byte level drivers, */
 633:BSP/u8g2/u8x8_cad.c ****       /* so this is done here. Even further, only 24 bytes will be sent, */
 634:BSP/u8g2/u8x8_cad.c ****       /* because there will be another byte (DC) required during the transfer */
 635:BSP/u8g2/u8x8_cad.c ****       p = arg_ptr;
 636:BSP/u8g2/u8x8_cad.c ****        while( arg_int > 24 )
