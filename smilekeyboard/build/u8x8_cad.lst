 381:BSP/u8g2/u8x8_cad.c ****     
 382:BSP/u8g2/u8x8_cad.c ****       /* the following loop increases speed by 20% */
 383:BSP/u8g2/u8x8_cad.c ****       while( arg_int >= 8 )
 384:BSP/u8g2/u8x8_cad.c ****       {
