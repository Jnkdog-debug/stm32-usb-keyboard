  82:BSP/u8g2/u8g2_hvline.c ****   /* be removed completly (be aware about memory curruption for wrong */
  83:BSP/u8g2/u8g2_hvline.c ****   /* arguments) or return 0 for a>b (will lead to skipped lines for wrong */
  84:BSP/u8g2/u8g2_hvline.c ****   /* arguments) */  
  85:BSP/u8g2/u8g2_hvline.c ****   
  86:BSP/u8g2/u8g2_hvline.c ****   /* removing the following if clause completly may lead to memory corruption of a>b */
