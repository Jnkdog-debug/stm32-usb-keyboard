  73:BSP/u8g2/u8g2_hvline.c ****       c <= d		(this is not checked)
  74:BSP/u8g2/u8g2_hvline.c ****     will return 0 if there is no intersection and if a > b
  75:BSP/u8g2/u8g2_hvline.c **** 
