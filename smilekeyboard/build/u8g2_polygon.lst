 267:BSP/u8g2/u8g2_polygon.c **** static void pg_exec(pg_struct *pg, u8g2_t *u8g2)
 268:BSP/u8g2/u8g2_polygon.c **** {
 269:BSP/u8g2/u8g2_polygon.c ****   pg_word_t i = pg->total_scan_line_cnt;
 270:BSP/u8g2/u8g2_polygon.c **** 
 271:BSP/u8g2/u8g2_polygon.c ****   /* first line is skipped if the min y line is not flat */
 272:BSP/u8g2/u8g2_polygon.c ****   pg_line_init(pg, PG_LEFT);		
 273:BSP/u8g2/u8g2_polygon.c ****   pg_line_init(pg, PG_RIGHT);
 274:BSP/u8g2/u8g2_polygon.c ****   
 275:BSP/u8g2/u8g2_polygon.c ****   if ( pg->is_min_y_not_flat != 0 )
 276:BSP/u8g2/u8g2_polygon.c ****   {
 277:BSP/u8g2/u8g2_polygon.c ****     pge_Next(&(pg->pge[PG_LEFT])); 
 278:BSP/u8g2/u8g2_polygon.c ****     pge_Next(&(pg->pge[PG_RIGHT]));
 279:BSP/u8g2/u8g2_polygon.c ****   }
 280:BSP/u8g2/u8g2_polygon.c **** 
 281:BSP/u8g2/u8g2_polygon.c ****   do
 282:BSP/u8g2/u8g2_polygon.c ****   {
 283:BSP/u8g2/u8g2_polygon.c ****     pg_hline(pg, u8g2);
 284:BSP/u8g2/u8g2_polygon.c ****     while ( pge_Next(&(pg->pge[PG_LEFT])) == 0 )
 285:BSP/u8g2/u8g2_polygon.c ****     {
 286:BSP/u8g2/u8g2_polygon.c ****       pg_line_init(pg, PG_LEFT);
 287:BSP/u8g2/u8g2_polygon.c ****     }
 288:BSP/u8g2/u8g2_polygon.c ****     while ( pge_Next(&(pg->pge[PG_RIGHT])) == 0 )
 289:BSP/u8g2/u8g2_polygon.c ****     {
 290:BSP/u8g2/u8g2_polygon.c ****       pg_line_init(pg, PG_RIGHT);
 291:BSP/u8g2/u8g2_polygon.c ****     }
 292:BSP/u8g2/u8g2_polygon.c ****     i--;
 293:BSP/u8g2/u8g2_polygon.c ****   } while( i > 0 );
 294:BSP/u8g2/u8g2_polygon.c **** }
