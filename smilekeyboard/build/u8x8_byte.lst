 106:BSP/u8g2/u8x8_byte.c **** 
 107:BSP/u8g2/u8x8_byte.c **** uint8_t u8x8_byte_4wire_sw_spi(u8x8_t *u8x8, uint8_t msg, uint8_t arg_int, void *arg_ptr)
 108:BSP/u8g2/u8x8_byte.c **** {
 109:BSP/u8g2/u8x8_byte.c ****   uint8_t i, b;
 110:BSP/u8g2/u8x8_byte.c ****   uint8_t *data;
 111:BSP/u8g2/u8x8_byte.c ****   uint8_t takeover_edge = u8x8_GetSPIClockPhase(u8x8);
 112:BSP/u8g2/u8x8_byte.c ****   uint8_t not_takeover_edge = 1 - takeover_edge;
 113:BSP/u8g2/u8x8_byte.c ****  
 114:BSP/u8g2/u8x8_byte.c ****   switch(msg)
 115:BSP/u8g2/u8x8_byte.c ****   {
 116:BSP/u8g2/u8x8_byte.c ****     case U8X8_MSG_BYTE_SEND:
 117:BSP/u8g2/u8x8_byte.c ****       data = (uint8_t *)arg_ptr;
 118:BSP/u8g2/u8x8_byte.c ****       while( arg_int > 0 )
 119:BSP/u8g2/u8x8_byte.c ****       {
 120:BSP/u8g2/u8x8_byte.c **** 	b = *data;
 121:BSP/u8g2/u8x8_byte.c **** 	data++;
 122:BSP/u8g2/u8x8_byte.c **** 	arg_int--;
 123:BSP/u8g2/u8x8_byte.c **** 	for( i = 0; i < 8; i++ )
 124:BSP/u8g2/u8x8_byte.c **** 	{
 125:BSP/u8g2/u8x8_byte.c **** 	  if ( b & 128 )
 126:BSP/u8g2/u8x8_byte.c **** 	    u8x8_gpio_SetSPIData(u8x8, 1);
 127:BSP/u8g2/u8x8_byte.c **** 	  else
 128:BSP/u8g2/u8x8_byte.c **** 	    u8x8_gpio_SetSPIData(u8x8, 0);
 129:BSP/u8g2/u8x8_byte.c **** 	  b <<= 1;
 130:BSP/u8g2/u8x8_byte.c **** 	  
 131:BSP/u8g2/u8x8_byte.c **** 	  u8x8_gpio_SetSPIClock(u8x8, not_takeover_edge);
 132:BSP/u8g2/u8x8_byte.c **** 	  u8x8_gpio_Delay(u8x8, U8X8_MSG_DELAY_NANO, u8x8->display_info->sda_setup_time_ns);
 133:BSP/u8g2/u8x8_byte.c **** 	  u8x8_gpio_SetSPIClock(u8x8, takeover_edge);
 134:BSP/u8g2/u8x8_byte.c **** 	  u8x8_gpio_Delay(u8x8, U8X8_MSG_DELAY_NANO, u8x8->display_info->sck_pulse_width_ns);
 135:BSP/u8g2/u8x8_byte.c **** 	}    
 136:BSP/u8g2/u8x8_byte.c ****       }
 137:BSP/u8g2/u8x8_byte.c ****       break;
 138:BSP/u8g2/u8x8_byte.c ****       
 139:BSP/u8g2/u8x8_byte.c ****     case U8X8_MSG_BYTE_INIT:
 140:BSP/u8g2/u8x8_byte.c ****       /* disable chipselect */
 141:BSP/u8g2/u8x8_byte.c ****       u8x8_gpio_SetCS(u8x8, u8x8->display_info->chip_disable_level);
 142:BSP/u8g2/u8x8_byte.c ****       /* no wait required here */
 143:BSP/u8g2/u8x8_byte.c ****       
 144:BSP/u8g2/u8x8_byte.c ****       /* for SPI: setup correct level of the clock signal */
 145:BSP/u8g2/u8x8_byte.c ****       u8x8_gpio_SetSPIClock(u8x8, u8x8_GetSPIClockPhase(u8x8));
 146:BSP/u8g2/u8x8_byte.c ****       break;
ARM GAS  /tmp/cc6PBIIV.s 			page 4


 147:BSP/u8g2/u8x8_byte.c ****     case U8X8_MSG_BYTE_SET_DC:
 148:BSP/u8g2/u8x8_byte.c ****       u8x8_gpio_SetDC(u8x8, arg_int);
 149:BSP/u8g2/u8x8_byte.c ****       break;
 150:BSP/u8g2/u8x8_byte.c ****     case U8X8_MSG_BYTE_START_TRANSFER:
 151:BSP/u8g2/u8x8_byte.c ****       u8x8_gpio_SetCS(u8x8, u8x8->display_info->chip_enable_level);  
 152:BSP/u8g2/u8x8_byte.c ****       u8x8->gpio_and_delay_cb(u8x8, U8X8_MSG_DELAY_NANO, u8x8->display_info->post_chip_enable_wait_
 153:BSP/u8g2/u8x8_byte.c ****       break;
 154:BSP/u8g2/u8x8_byte.c ****     case U8X8_MSG_BYTE_END_TRANSFER:
 155:BSP/u8g2/u8x8_byte.c ****       u8x8->gpio_and_delay_cb(u8x8, U8X8_MSG_DELAY_NANO, u8x8->display_info->pre_chip_disable_wait_
 156:BSP/u8g2/u8x8_byte.c ****       u8x8_gpio_SetCS(u8x8, u8x8->display_info->chip_disable_level);
 157:BSP/u8g2/u8x8_byte.c ****       break;
 158:BSP/u8g2/u8x8_byte.c ****     default:
 159:BSP/u8g2/u8x8_byte.c ****       return 0;
 160:BSP/u8g2/u8x8_byte.c ****   }
 161:BSP/u8g2/u8x8_byte.c ****   return 1;
 162:BSP/u8g2/u8x8_byte.c **** }
