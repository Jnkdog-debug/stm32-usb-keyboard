 166:BSP/u8g2/u8x8_byte.c **** uint8_t u8x8_byte_8bit_6800mode(u8x8_t *u8x8, uint8_t msg, uint8_t arg_int, void *arg_ptr)
 167:BSP/u8g2/u8x8_byte.c **** {
 168:BSP/u8g2/u8x8_byte.c ****   uint8_t i, b;
 169:BSP/u8g2/u8x8_byte.c ****   uint8_t *data;
 170:BSP/u8g2/u8x8_byte.c ****  
 171:BSP/u8g2/u8x8_byte.c ****   switch(msg)
 172:BSP/u8g2/u8x8_byte.c ****   {
 173:BSP/u8g2/u8x8_byte.c ****     case U8X8_MSG_BYTE_SEND:
 174:BSP/u8g2/u8x8_byte.c ****       data = (uint8_t *)arg_ptr;
 175:BSP/u8g2/u8x8_byte.c ****       while( arg_int > 0 )
 176:BSP/u8g2/u8x8_byte.c ****       {
 177:BSP/u8g2/u8x8_byte.c **** 	b = *data;
 178:BSP/u8g2/u8x8_byte.c **** 	data++;
 179:BSP/u8g2/u8x8_byte.c **** 	arg_int--;
 180:BSP/u8g2/u8x8_byte.c **** 	for( i = U8X8_MSG_GPIO_D0; i <= U8X8_MSG_GPIO_D7; i++ )
 181:BSP/u8g2/u8x8_byte.c **** 	{
 182:BSP/u8g2/u8x8_byte.c **** 	  u8x8_gpio_call(u8x8, i, b&1);
 183:BSP/u8g2/u8x8_byte.c **** 	  b >>= 1;
 184:BSP/u8g2/u8x8_byte.c **** 	}    
 185:BSP/u8g2/u8x8_byte.c **** 	
 186:BSP/u8g2/u8x8_byte.c **** 	u8x8_gpio_Delay(u8x8, U8X8_MSG_DELAY_NANO, u8x8->display_info->data_setup_time_ns);
 187:BSP/u8g2/u8x8_byte.c **** 	u8x8_gpio_call(u8x8, U8X8_MSG_GPIO_E, 1);
 188:BSP/u8g2/u8x8_byte.c **** 	u8x8_gpio_Delay(u8x8, U8X8_MSG_DELAY_NANO, u8x8->display_info->write_pulse_width_ns);
 189:BSP/u8g2/u8x8_byte.c **** 	u8x8_gpio_call(u8x8, U8X8_MSG_GPIO_E, 0);
 190:BSP/u8g2/u8x8_byte.c ****       }
 191:BSP/u8g2/u8x8_byte.c ****       break;
 192:BSP/u8g2/u8x8_byte.c ****       
 193:BSP/u8g2/u8x8_byte.c ****     case U8X8_MSG_BYTE_INIT:
 194:BSP/u8g2/u8x8_byte.c ****       /* disable chipselect */
 195:BSP/u8g2/u8x8_byte.c ****       u8x8_gpio_SetCS(u8x8, u8x8->display_info->chip_disable_level);    
 196:BSP/u8g2/u8x8_byte.c ****       /* ensure that the enable signal is high */
 197:BSP/u8g2/u8x8_byte.c ****       u8x8_gpio_call(u8x8, U8X8_MSG_GPIO_E, 0);
 198:BSP/u8g2/u8x8_byte.c ****       break;
 199:BSP/u8g2/u8x8_byte.c ****     case U8X8_MSG_BYTE_SET_DC:
