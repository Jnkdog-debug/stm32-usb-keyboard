 267:BSP/u8g2/u8x8_byte.c **** 
 268:BSP/u8g2/u8x8_byte.c **** uint8_t u8x8_byte_3wire_sw_spi(u8x8_t *u8x8, uint8_t msg, uint8_t arg_int, void *arg_ptr)
 269:BSP/u8g2/u8x8_byte.c **** {
 270:BSP/u8g2/u8x8_byte.c ****   uint8_t i;
 271:BSP/u8g2/u8x8_byte.c ****   uint8_t *data;
 272:BSP/u8g2/u8x8_byte.c ****   uint8_t takeover_edge = u8x8_GetSPIClockPhase(u8x8);
 273:BSP/u8g2/u8x8_byte.c ****   uint8_t not_takeover_edge = 1 - takeover_edge;
 274:BSP/u8g2/u8x8_byte.c ****   uint16_t b;
 275:BSP/u8g2/u8x8_byte.c ****   static uint8_t last_dc;
 276:BSP/u8g2/u8x8_byte.c ****  
 277:BSP/u8g2/u8x8_byte.c ****   switch(msg)
 278:BSP/u8g2/u8x8_byte.c ****   {
 279:BSP/u8g2/u8x8_byte.c ****     case U8X8_MSG_BYTE_SEND:
 280:BSP/u8g2/u8x8_byte.c ****       data = (uint8_t *)arg_ptr;
 281:BSP/u8g2/u8x8_byte.c ****       while( arg_int > 0 )
 282:BSP/u8g2/u8x8_byte.c ****       {
 283:BSP/u8g2/u8x8_byte.c **** 	b = *data;
 284:BSP/u8g2/u8x8_byte.c **** 	if ( last_dc != 0 )
 285:BSP/u8g2/u8x8_byte.c **** 	  b |= 256;
 286:BSP/u8g2/u8x8_byte.c **** 	data++;
 287:BSP/u8g2/u8x8_byte.c **** 	arg_int--;
 288:BSP/u8g2/u8x8_byte.c **** 	for( i = 0; i < 9; i++ )
 289:BSP/u8g2/u8x8_byte.c **** 	{
 290:BSP/u8g2/u8x8_byte.c **** 	  if ( b & 256 )
 291:BSP/u8g2/u8x8_byte.c **** 	    u8x8_gpio_SetSPIData(u8x8, 1);
 292:BSP/u8g2/u8x8_byte.c **** 	  else
 293:BSP/u8g2/u8x8_byte.c **** 	    u8x8_gpio_SetSPIData(u8x8, 0);
 294:BSP/u8g2/u8x8_byte.c **** 	  b <<= 1;
 295:BSP/u8g2/u8x8_byte.c **** 	  
 296:BSP/u8g2/u8x8_byte.c **** 	  u8x8_gpio_SetSPIClock(u8x8, not_takeover_edge);
 297:BSP/u8g2/u8x8_byte.c **** 	  u8x8_gpio_Delay(u8x8, U8X8_MSG_DELAY_NANO, u8x8->display_info->sda_setup_time_ns);
 298:BSP/u8g2/u8x8_byte.c **** 	  u8x8_gpio_SetSPIClock(u8x8, takeover_edge);
 299:BSP/u8g2/u8x8_byte.c **** 	  u8x8_gpio_Delay(u8x8, U8X8_MSG_DELAY_NANO, u8x8->display_info->sck_pulse_width_ns);
 300:BSP/u8g2/u8x8_byte.c **** 	}    
 301:BSP/u8g2/u8x8_byte.c ****       }
 302:BSP/u8g2/u8x8_byte.c ****       break;
 303:BSP/u8g2/u8x8_byte.c ****       
 304:BSP/u8g2/u8x8_byte.c ****     case U8X8_MSG_BYTE_INIT:
 305:BSP/u8g2/u8x8_byte.c ****       /* disable chipselect */
 306:BSP/u8g2/u8x8_byte.c ****       u8x8_gpio_SetCS(u8x8, u8x8->display_info->chip_disable_level);
 307:BSP/u8g2/u8x8_byte.c ****       /* no wait required here */
 308:BSP/u8g2/u8x8_byte.c ****       
 309:BSP/u8g2/u8x8_byte.c ****       /* for SPI: setup correct level of the clock signal */
 310:BSP/u8g2/u8x8_byte.c ****       u8x8_gpio_SetSPIClock(u8x8, u8x8_GetSPIClockPhase(u8x8));
 311:BSP/u8g2/u8x8_byte.c ****       break;
 312:BSP/u8g2/u8x8_byte.c ****     case U8X8_MSG_BYTE_SET_DC:
 313:BSP/u8g2/u8x8_byte.c ****       last_dc = arg_int;
 314:BSP/u8g2/u8x8_byte.c ****       break;
 315:BSP/u8g2/u8x8_byte.c ****     case U8X8_MSG_BYTE_START_TRANSFER:
 316:BSP/u8g2/u8x8_byte.c ****       u8x8_gpio_SetCS(u8x8, u8x8->display_info->chip_enable_level);  
 317:BSP/u8g2/u8x8_byte.c ****       u8x8->gpio_and_delay_cb(u8x8, U8X8_MSG_DELAY_NANO, u8x8->display_info->post_chip_enable_wait_
ARM GAS  /tmp/cc6PBIIV.s 			page 7


 318:BSP/u8g2/u8x8_byte.c ****       break;
 319:BSP/u8g2/u8x8_byte.c ****     case U8X8_MSG_BYTE_END_TRANSFER:
 320:BSP/u8g2/u8x8_byte.c ****       u8x8->gpio_and_delay_cb(u8x8, U8X8_MSG_DELAY_NANO, u8x8->display_info->pre_chip_disable_wait_
 321:BSP/u8g2/u8x8_byte.c ****       u8x8_gpio_SetCS(u8x8, u8x8->display_info->chip_disable_level);
 322:BSP/u8g2/u8x8_byte.c ****       break;
 323:BSP/u8g2/u8x8_byte.c ****     default:
 324:BSP/u8g2/u8x8_byte.c ****       return 0;
 325:BSP/u8g2/u8x8_byte.c ****   }
 326:BSP/u8g2/u8x8_byte.c ****   return 1;
 327:BSP/u8g2/u8x8_byte.c **** }
