  41:BSP/u8g2/u8x8_debounce.c **** {
  42:BSP/u8g2/u8x8_debounce.c ****   uint8_t i;
  43:BSP/u8g2/u8x8_debounce.c ****   uint8_t pin_state;
  44:BSP/u8g2/u8x8_debounce.c ****   
  45:BSP/u8g2/u8x8_debounce.c ****   pin_state = 255;	/* be compatible with the setup of the default pin setup, which is 255 */
  46:BSP/u8g2/u8x8_debounce.c ****   for( i = 0; i < U8X8_PIN_INPUT_CNT; i++ )
  47:BSP/u8g2/u8x8_debounce.c ****   {
  48:BSP/u8g2/u8x8_debounce.c ****     pin_state <<= 1;
  49:BSP/u8g2/u8x8_debounce.c ****     
  50:BSP/u8g2/u8x8_debounce.c ****     /* the callback function should put the return value into this variable */
  51:BSP/u8g2/u8x8_debounce.c ****     u8x8->gpio_result = 1;
  52:BSP/u8g2/u8x8_debounce.c ****     u8x8_gpio_call(u8x8, U8X8_MSG_GPIO(i+U8X8_PIN_OUTPUT_CNT), 0);
  53:BSP/u8g2/u8x8_debounce.c ****     pin_state |= u8x8->gpio_result & 1;
  54:BSP/u8g2/u8x8_debounce.c ****   }
  55:BSP/u8g2/u8x8_debounce.c ****   
  56:BSP/u8g2/u8x8_debounce.c ****   return pin_state;
  57:BSP/u8g2/u8x8_debounce.c **** }
