 108:BSP/u8g2/u8x8_debounce.c **** #include <stdlib.h>
 109:BSP/u8g2/u8x8_debounce.c **** uint8_t u8x8_GetMenuEvent(u8x8_t *u8x8)
 110:BSP/u8g2/u8x8_debounce.c **** {
 111:BSP/u8g2/u8x8_debounce.c ****     int c;
 112:BSP/u8g2/u8x8_debounce.c ****     c = getc(stdin);
 113:BSP/u8g2/u8x8_debounce.c ****     switch(c)
 114:BSP/u8g2/u8x8_debounce.c ****     {
 115:BSP/u8g2/u8x8_debounce.c ****         case 'n':
 116:BSP/u8g2/u8x8_debounce.c ****             return  U8X8_MSG_GPIO_MENU_NEXT;
 117:BSP/u8g2/u8x8_debounce.c ****         case 'p':
 118:BSP/u8g2/u8x8_debounce.c ****             return  U8X8_MSG_GPIO_MENU_PREV;
 119:BSP/u8g2/u8x8_debounce.c ****         case 's':
 120:BSP/u8g2/u8x8_debounce.c ****             return  U8X8_MSG_GPIO_MENU_SELECT;
 121:BSP/u8g2/u8x8_debounce.c ****         case 'h':
 122:BSP/u8g2/u8x8_debounce.c ****             return  U8X8_MSG_GPIO_MENU_HOME;
 123:BSP/u8g2/u8x8_debounce.c ****         case 'x':
 124:BSP/u8g2/u8x8_debounce.c ****             exit(0);
 125:BSP/u8g2/u8x8_debounce.c ****         default:
 126:BSP/u8g2/u8x8_debounce.c ****             puts("press n, p, s, h or x");
 127:BSP/u8g2/u8x8_debounce.c ****             break;
 128:BSP/u8g2/u8x8_debounce.c ****     }
 129:BSP/u8g2/u8x8_debounce.c ****     return 0;
 130:BSP/u8g2/u8x8_debounce.c **** }
