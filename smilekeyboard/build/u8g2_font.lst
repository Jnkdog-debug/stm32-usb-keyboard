 536:BSP/u8g2/u8g2_font.c **** 	    x0++;	/* shift down, because of assymetric boundaries for the interseciton test */
 537:BSP/u8g2/u8g2_font.c **** 	    x1++;
 538:BSP/u8g2/u8g2_font.c **** 	    y0 -= h;
 539:BSP/u8g2/u8g2_font.c **** 	    y0++;	/* shift down, because of assymetric boundaries for the interseciton test */
 540:BSP/u8g2/u8g2_font.c **** 	    y1++;
 541:BSP/u8g2/u8g2_font.c **** 	    break;	  
 542:BSP/u8g2/u8g2_font.c **** 	case 3:
