 598:BSP/u8g2/u8g2_font.c ****   if ( encoding <= 255 )
 599:BSP/u8g2/u8g2_font.c ****   {
 600:BSP/u8g2/u8g2_font.c ****     if ( encoding >= 'a' )
 601:BSP/u8g2/u8g2_font.c ****     {
