 168:BSP/u8g2/u8g2_font.c **** 
 169:BSP/u8g2/u8g2_font.c **** /* calculate the overall length of the font, only used to create the picture for the google wiki */
 170:BSP/u8g2/u8g2_font.c **** size_t u8g2_GetFontSize(const uint8_t *font_arg)
 171:BSP/u8g2/u8g2_font.c **** {
 172:BSP/u8g2/u8g2_font.c ****   uint16_t e;
 173:BSP/u8g2/u8g2_font.c ****   const uint8_t *font = font_arg;
 174:BSP/u8g2/u8g2_font.c ****   font += U8G2_FONT_DATA_STRUCT_SIZE;
 175:BSP/u8g2/u8g2_font.c ****   
 176:BSP/u8g2/u8g2_font.c ****   for(;;)
 177:BSP/u8g2/u8g2_font.c ****   {
 178:BSP/u8g2/u8g2_font.c ****     if ( u8x8_pgm_read( font + 1 ) == 0 )
 179:BSP/u8g2/u8g2_font.c ****       break;
 180:BSP/u8g2/u8g2_font.c ****     font += u8x8_pgm_read( font + 1 );
 181:BSP/u8g2/u8g2_font.c ****   }
 182:BSP/u8g2/u8g2_font.c ****   
 183:BSP/u8g2/u8g2_font.c ****   /* continue with unicode section */
 184:BSP/u8g2/u8g2_font.c ****   font += 2;
 185:BSP/u8g2/u8g2_font.c **** 
 186:BSP/u8g2/u8g2_font.c ****   /* skip unicode lookup table */
 187:BSP/u8g2/u8g2_font.c ****   font += u8g2_font_get_word(font, 0);
 188:BSP/u8g2/u8g2_font.c ****   
 189:BSP/u8g2/u8g2_font.c ****   for(;;)
 190:BSP/u8g2/u8g2_font.c ****   {
 191:BSP/u8g2/u8g2_font.c ****     e = u8x8_pgm_read( font );
 192:BSP/u8g2/u8g2_font.c ****     e <<= 8;
 193:BSP/u8g2/u8g2_font.c ****     e |= u8x8_pgm_read( font + 1 );
 194:BSP/u8g2/u8g2_font.c ****     if ( e == 0 )
 195:BSP/u8g2/u8g2_font.c ****       break;
 196:BSP/u8g2/u8g2_font.c ****     font += u8x8_pgm_read( font + 2 );    
 197:BSP/u8g2/u8g2_font.c ****   }
 198:BSP/u8g2/u8g2_font.c ****   
 199:BSP/u8g2/u8g2_font.c ****   return (font - font_arg) + 2;
 200:BSP/u8g2/u8g2_font.c **** }
 201:BSP/u8g2/u8g2_font.c **** 
