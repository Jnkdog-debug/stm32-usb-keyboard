 555:BSP/u8g2/u8g2_font.c **** 	return d;
 556:BSP/u8g2/u8g2_font.c ****     }
 557:BSP/u8g2/u8g2_font.c **** #endif /* U8G2_WITH_INTERSECTION */
 558:BSP/u8g2/u8g2_font.c ****    
 559:BSP/u8g2/u8g2_font.c ****     /* reset local x/y position */
 560:BSP/u8g2/u8g2_font.c ****     decode->x = 0;
 561:BSP/u8g2/u8g2_font.c ****     decode->y = 0;
 562:BSP/u8g2/u8g2_font.c ****     
 563:BSP/u8g2/u8g2_font.c ****     /* decode glyph */
