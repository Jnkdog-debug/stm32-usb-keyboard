 341:BSP/u8g2/u8g2_font.c **** /*
 342:BSP/u8g2/u8g2_font.c ****   Description:
 343:BSP/u8g2/u8g2_font.c ****     Draw a run-length area of the glyph. "len" can have any size and the line
 344:BSP/u8g2/u8g2_font.c ****     length has to be wrapped at the glyph border.
 345:BSP/u8g2/u8g2_font.c ****   Args:
 346:BSP/u8g2/u8g2_font.c ****     len: 					Length of the line
 347:BSP/u8g2/u8g2_font.c ****     is_foreground			foreground/background?
 348:BSP/u8g2/u8g2_font.c ****     u8g2->font_decode.target_x		X position
 349:BSP/u8g2/u8g2_font.c ****     u8g2->font_decode.target_y		Y position
 350:BSP/u8g2/u8g2_font.c ****     u8g2->font_decode.is_transparent	Transparent mode
 351:BSP/u8g2/u8g2_font.c ****   Return:
 352:BSP/u8g2/u8g2_font.c ****     -
 353:BSP/u8g2/u8g2_font.c ****   Calls:
 354:BSP/u8g2/u8g2_font.c ****     u8g2_Draw90Line()
 355:BSP/u8g2/u8g2_font.c ****   Called by:
 356:BSP/u8g2/u8g2_font.c ****     u8g2_font_decode_glyph()
 357:BSP/u8g2/u8g2_font.c **** */
 358:BSP/u8g2/u8g2_font.c **** /* optimized */
 359:BSP/u8g2/u8g2_font.c **** void u8g2_font_decode_len(u8g2_t *u8g2, uint8_t len, uint8_t is_foreground)
 360:BSP/u8g2/u8g2_font.c **** {
 361:BSP/u8g2/u8g2_font.c ****   uint8_t cnt;	/* total number of remaining pixels, which have to be drawn */
ARM GAS  /tmp/cc5sAzkx.s 			page 11


 362:BSP/u8g2/u8g2_font.c ****   uint8_t rem; 	/* remaining pixel to the right edge of the glyph */
 363:BSP/u8g2/u8g2_font.c ****   uint8_t current;	/* number of pixels, which need to be drawn for the draw procedure */
 364:BSP/u8g2/u8g2_font.c ****     /* current is either equal to cnt or equal to rem */
 365:BSP/u8g2/u8g2_font.c ****   
 366:BSP/u8g2/u8g2_font.c ****   /* local coordinates of the glyph */
 367:BSP/u8g2/u8g2_font.c ****   uint8_t lx,ly;
 368:BSP/u8g2/u8g2_font.c ****   
 369:BSP/u8g2/u8g2_font.c ****   /* target position on the screen */
 370:BSP/u8g2/u8g2_font.c ****   u8g2_uint_t x, y;
 371:BSP/u8g2/u8g2_font.c ****   
 372:BSP/u8g2/u8g2_font.c ****   u8g2_font_decode_t *decode = &(u8g2->font_decode);
 373:BSP/u8g2/u8g2_font.c ****   
 374:BSP/u8g2/u8g2_font.c ****   cnt = len;
 375:BSP/u8g2/u8g2_font.c ****   
 376:BSP/u8g2/u8g2_font.c ****   /* get the local position */
 377:BSP/u8g2/u8g2_font.c ****   lx = decode->x;
 378:BSP/u8g2/u8g2_font.c ****   ly = decode->y;
 379:BSP/u8g2/u8g2_font.c ****   
 380:BSP/u8g2/u8g2_font.c ****   for(;;)
 381:BSP/u8g2/u8g2_font.c ****   {
 382:BSP/u8g2/u8g2_font.c ****     /* calculate the number of pixel to the right edge of the glyph */
 383:BSP/u8g2/u8g2_font.c ****     rem = decode->glyph_width;
 384:BSP/u8g2/u8g2_font.c ****     rem -= lx;
 385:BSP/u8g2/u8g2_font.c ****     
 386:BSP/u8g2/u8g2_font.c ****     /* calculate how many pixel to draw. This is either to the right edge */
 387:BSP/u8g2/u8g2_font.c ****     /* or lesser, if not enough pixel are left */
 388:BSP/u8g2/u8g2_font.c ****     current = rem;
 389:BSP/u8g2/u8g2_font.c ****     if ( cnt < rem )
 390:BSP/u8g2/u8g2_font.c ****       current = cnt;
 391:BSP/u8g2/u8g2_font.c ****     
 392:BSP/u8g2/u8g2_font.c ****     
 393:BSP/u8g2/u8g2_font.c ****     /* now draw the line, but apply the rotation around the glyph target position */
 394:BSP/u8g2/u8g2_font.c ****     //u8g2_font_decode_draw_pixel(u8g2, lx,ly,current, is_foreground);
 395:BSP/u8g2/u8g2_font.c **** 
 396:BSP/u8g2/u8g2_font.c ****     /* get target position */
 397:BSP/u8g2/u8g2_font.c ****     x = decode->target_x;
 398:BSP/u8g2/u8g2_font.c ****     y = decode->target_y;
 399:BSP/u8g2/u8g2_font.c **** 
 400:BSP/u8g2/u8g2_font.c ****     /* apply rotation */
 401:BSP/u8g2/u8g2_font.c **** #ifdef U8G2_WITH_FONT_ROTATION
 402:BSP/u8g2/u8g2_font.c ****     x = u8g2_add_vector_x(x, lx, ly, decode->dir);
