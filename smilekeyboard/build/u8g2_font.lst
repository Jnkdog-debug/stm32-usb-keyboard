  36:BSP/u8g2/u8g2_font.c **** #include "u8g2.h"
  37:BSP/u8g2/u8g2_font.c **** 
  38:BSP/u8g2/u8g2_font.c **** /* size of the font data structure, there is no struct or class... */
  39:BSP/u8g2/u8g2_font.c **** /* this is the size for the new font format */
  40:BSP/u8g2/u8g2_font.c **** #define U8G2_FONT_DATA_STRUCT_SIZE 23
  41:BSP/u8g2/u8g2_font.c **** 
  42:BSP/u8g2/u8g2_font.c **** /*
  43:BSP/u8g2/u8g2_font.c ****   font data:
  44:BSP/u8g2/u8g2_font.c **** 
  45:BSP/u8g2/u8g2_font.c ****   offset	bytes	description
  46:BSP/u8g2/u8g2_font.c ****   0		1		glyph_cnt		number of glyphs
  47:BSP/u8g2/u8g2_font.c ****   1		1		bbx_mode	0: proportional, 1: common height, 2: monospace, 3: multiple of 8
  48:BSP/u8g2/u8g2_font.c ****   2		1		bits_per_0	glyph rle parameter
  49:BSP/u8g2/u8g2_font.c ****   3		1		bits_per_1	glyph rle parameter
  50:BSP/u8g2/u8g2_font.c **** 
  51:BSP/u8g2/u8g2_font.c ****   4		1		bits_per_char_width		glyph rle parameter
  52:BSP/u8g2/u8g2_font.c ****   5		1		bits_per_char_height	glyph rle parameter
  53:BSP/u8g2/u8g2_font.c ****   6		1		bits_per_char_x		glyph rle parameter
  54:BSP/u8g2/u8g2_font.c ****   7		1		bits_per_char_y		glyph rle parameter
  55:BSP/u8g2/u8g2_font.c ****   8		1		bits_per_delta_x		glyph rle parameter
  56:BSP/u8g2/u8g2_font.c **** 
  57:BSP/u8g2/u8g2_font.c ****   9		1		max_char_width
  58:BSP/u8g2/u8g2_font.c ****   10		1		max_char_height
  59:BSP/u8g2/u8g2_font.c ****   11		1		x offset
  60:BSP/u8g2/u8g2_font.c ****   12		1		y offset (descent)
  61:BSP/u8g2/u8g2_font.c ****   
  62:BSP/u8g2/u8g2_font.c ****   13		1		ascent (capital A)
  63:BSP/u8g2/u8g2_font.c ****   14		1		descent (lower g)
  64:BSP/u8g2/u8g2_font.c ****   15		1		ascent '('
  65:BSP/u8g2/u8g2_font.c ****   16		1		descent ')'
  66:BSP/u8g2/u8g2_font.c ****   
  67:BSP/u8g2/u8g2_font.c ****   17		1		start pos 'A' high byte
  68:BSP/u8g2/u8g2_font.c ****   18		1		start pos 'A' low byte
  69:BSP/u8g2/u8g2_font.c **** 
  70:BSP/u8g2/u8g2_font.c ****   19		1		start pos 'a' high byte
  71:BSP/u8g2/u8g2_font.c ****   20		1		start pos 'a' low byte
  72:BSP/u8g2/u8g2_font.c **** 
  73:BSP/u8g2/u8g2_font.c ****   21		1		start pos unicode high byte
  74:BSP/u8g2/u8g2_font.c ****   22		1		start pos unicode low byte
  75:BSP/u8g2/u8g2_font.c **** 
  76:BSP/u8g2/u8g2_font.c ****   Font build mode, 0: proportional, 1: common height, 2: monospace, 3: multiple of 8
  77:BSP/u8g2/u8g2_font.c **** 
  78:BSP/u8g2/u8g2_font.c ****   Font build mode 0:		
  79:BSP/u8g2/u8g2_font.c ****     - "t"
  80:BSP/u8g2/u8g2_font.c ****     - Ref height mode: U8G2_FONT_HEIGHT_MODE_TEXT, U8G2_FONT_HEIGHT_MODE_XTEXT or U8G2_FONT_HEIGHT_
  81:BSP/u8g2/u8g2_font.c ****     - use in transparent mode only (does not look good in solid mode)
  82:BSP/u8g2/u8g2_font.c ****     - most compact format
  83:BSP/u8g2/u8g2_font.c ****     - different font heights possible
  84:BSP/u8g2/u8g2_font.c ****     
  85:BSP/u8g2/u8g2_font.c ****   Font build mode 1:		
  86:BSP/u8g2/u8g2_font.c ****     - "h"
  87:BSP/u8g2/u8g2_font.c ****     - Ref height mode: U8G2_FONT_HEIGHT_MODE_ALL
  88:BSP/u8g2/u8g2_font.c ****     - transparent or solid mode
  89:BSP/u8g2/u8g2_font.c ****     - The height of the glyphs depend on the largest glyph in the font. This means font height depe
