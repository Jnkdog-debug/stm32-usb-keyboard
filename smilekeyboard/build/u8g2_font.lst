 607:BSP/u8g2/u8g2_font.c ****     }
 608:BSP/u8g2/u8g2_font.c ****     
 609:BSP/u8g2/u8g2_font.c ****     for(;;)
 610:BSP/u8g2/u8g2_font.c ****     {
 611:BSP/u8g2/u8g2_font.c ****       if ( u8x8_pgm_read( font + 1 ) == 0 )
