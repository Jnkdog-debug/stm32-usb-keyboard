 512:BSP/u8g2/u8g2_font.c **** 
 513:BSP/u8g2/u8g2_font.c **** #ifdef U8G2_WITH_INTERSECTION
 514:BSP/u8g2/u8g2_font.c ****     {
 515:BSP/u8g2/u8g2_font.c ****       u8g2_uint_t x0, x1, y0, y1;
 516:BSP/u8g2/u8g2_font.c ****       x0 = decode->target_x;
 517:BSP/u8g2/u8g2_font.c ****       y0 = decode->target_y;
 518:BSP/u8g2/u8g2_font.c ****       x1 = x0;
 519:BSP/u8g2/u8g2_font.c ****       y1 = y0;
 520:BSP/u8g2/u8g2_font.c ****       
 521:BSP/u8g2/u8g2_font.c **** #ifdef U8G2_WITH_FONT_ROTATION
 522:BSP/u8g2/u8g2_font.c ****       switch(decode->dir)
 523:BSP/u8g2/u8g2_font.c ****       {
 524:BSP/u8g2/u8g2_font.c **** 	case 0:
 525:BSP/u8g2/u8g2_font.c **** 	    x1 += decode->glyph_width;
 526:BSP/u8g2/u8g2_font.c **** 	    y1 += h;
