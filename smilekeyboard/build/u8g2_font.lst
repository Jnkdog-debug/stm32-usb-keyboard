 592:BSP/u8g2/u8g2_font.c **** const uint8_t *u8g2_font_get_glyph_data(u8g2_t *u8g2, uint16_t encoding)
 593:BSP/u8g2/u8g2_font.c **** {
 594:BSP/u8g2/u8g2_font.c ****   const uint8_t *font = u8g2->font;
 595:BSP/u8g2/u8g2_font.c ****   font += U8G2_FONT_DATA_STRUCT_SIZE;
