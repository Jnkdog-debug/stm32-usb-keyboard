 130:BSP/u8g2/u8g2_font.c **** /* new font format */
 131:BSP/u8g2/u8g2_font.c **** void u8g2_read_font_info(u8g2_font_info_t *font_info, const uint8_t *font)
 132:BSP/u8g2/u8g2_font.c **** {
 133:BSP/u8g2/u8g2_font.c ****   /* offset 0 */
 134:BSP/u8g2/u8g2_font.c ****   font_info->glyph_cnt = u8g2_font_get_byte(font, 0);
 135:BSP/u8g2/u8g2_font.c ****   font_info->bbx_mode = u8g2_font_get_byte(font, 1);
 136:BSP/u8g2/u8g2_font.c ****   font_info->bits_per_0 = u8g2_font_get_byte(font, 2);
 137:BSP/u8g2/u8g2_font.c ****   font_info->bits_per_1 = u8g2_font_get_byte(font, 3);
 138:BSP/u8g2/u8g2_font.c ****   
 139:BSP/u8g2/u8g2_font.c ****   /* offset 4 */
 140:BSP/u8g2/u8g2_font.c ****   font_info->bits_per_char_width = u8g2_font_get_byte(font, 4);
 141:BSP/u8g2/u8g2_font.c ****   font_info->bits_per_char_height = u8g2_font_get_byte(font, 5);
 142:BSP/u8g2/u8g2_font.c ****   font_info->bits_per_char_x = u8g2_font_get_byte(font, 6);
 143:BSP/u8g2/u8g2_font.c ****   font_info->bits_per_char_y = u8g2_font_get_byte(font, 7);
 144:BSP/u8g2/u8g2_font.c ****   font_info->bits_per_delta_x = u8g2_font_get_byte(font, 8);
ARM GAS  /tmp/cc5sAzkx.s 			page 5


 145:BSP/u8g2/u8g2_font.c ****   
 146:BSP/u8g2/u8g2_font.c ****   /* offset 9 */
 147:BSP/u8g2/u8g2_font.c ****   font_info->max_char_width = u8g2_font_get_byte(font, 9);
 148:BSP/u8g2/u8g2_font.c ****   font_info->max_char_height = u8g2_font_get_byte(font, 10);
 149:BSP/u8g2/u8g2_font.c ****   font_info->x_offset = u8g2_font_get_byte(font, 11);
 150:BSP/u8g2/u8g2_font.c ****   font_info->y_offset = u8g2_font_get_byte(font, 12);
 151:BSP/u8g2/u8g2_font.c ****   
 152:BSP/u8g2/u8g2_font.c ****   /* offset 13 */
 153:BSP/u8g2/u8g2_font.c ****   font_info->ascent_A = u8g2_font_get_byte(font, 13);
 154:BSP/u8g2/u8g2_font.c ****   font_info->descent_g = u8g2_font_get_byte(font, 14);
 155:BSP/u8g2/u8g2_font.c ****   font_info->ascent_para = u8g2_font_get_byte(font, 15);
 156:BSP/u8g2/u8g2_font.c ****   font_info->descent_para = u8g2_font_get_byte(font, 16);
 157:BSP/u8g2/u8g2_font.c ****   
 158:BSP/u8g2/u8g2_font.c ****   /* offset 17 */
 159:BSP/u8g2/u8g2_font.c ****   font_info->start_pos_upper_A = u8g2_font_get_word(font, 17);
 160:BSP/u8g2/u8g2_font.c ****   font_info->start_pos_lower_a = u8g2_font_get_word(font, 19); 
 161:BSP/u8g2/u8g2_font.c ****   
 162:BSP/u8g2/u8g2_font.c ****   /* offset 21 */
 163:BSP/u8g2/u8g2_font.c **** #ifdef U8G2_WITH_UNICODE
 164:BSP/u8g2/u8g2_font.c ****   font_info->start_pos_unicode = u8g2_font_get_word(font, 21); 
 165:BSP/u8g2/u8g2_font.c **** #endif
 166:BSP/u8g2/u8g2_font.c **** }
