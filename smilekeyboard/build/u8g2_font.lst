 546:BSP/u8g2/u8g2_font.c **** 	    y1++;
 547:BSP/u8g2/u8g2_font.c **** 	    break;	  
 548:BSP/u8g2/u8g2_font.c ****       }
 549:BSP/u8g2/u8g2_font.c **** #else /* U8G2_WITH_FONT_ROTATION */
 550:BSP/u8g2/u8g2_font.c ****       x1 += decode->glyph_width;
 551:BSP/u8g2/u8g2_font.c ****       y1 += h;      
 552:BSP/u8g2/u8g2_font.c **** #endif
