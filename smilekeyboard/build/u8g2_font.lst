 485:BSP/u8g2/u8g2_font.c **** */
 486:BSP/u8g2/u8g2_font.c **** /* optimized */
 487:BSP/u8g2/u8g2_font.c **** int8_t u8g2_font_decode_glyph(u8g2_t *u8g2, const uint8_t *glyph_data)
 488:BSP/u8g2/u8g2_font.c **** {
 489:BSP/u8g2/u8g2_font.c ****   uint8_t a, b;
 490:BSP/u8g2/u8g2_font.c ****   int8_t x, y;
 491:BSP/u8g2/u8g2_font.c ****   int8_t d;
 492:BSP/u8g2/u8g2_font.c ****   int8_t h;
 493:BSP/u8g2/u8g2_font.c ****   u8g2_font_decode_t *decode = &(u8g2->font_decode);
 494:BSP/u8g2/u8g2_font.c ****     
 495:BSP/u8g2/u8g2_font.c ****   u8g2_font_setup_decode(u8g2, glyph_data);
 496:BSP/u8g2/u8g2_font.c ****   h = u8g2->font_decode.glyph_height;
 497:BSP/u8g2/u8g2_font.c ****   
 498:BSP/u8g2/u8g2_font.c ****   x = u8g2_font_decode_get_signed_bits(decode, u8g2->font_info.bits_per_char_x);
 499:BSP/u8g2/u8g2_font.c ****   y = u8g2_font_decode_get_signed_bits(decode, u8g2->font_info.bits_per_char_y);
 500:BSP/u8g2/u8g2_font.c ****   d = u8g2_font_decode_get_signed_bits(decode, u8g2->font_info.bits_per_delta_x);
 501:BSP/u8g2/u8g2_font.c ****   
 502:BSP/u8g2/u8g2_font.c ****   if ( decode->glyph_width > 0 )
 503:BSP/u8g2/u8g2_font.c ****   {
 504:BSP/u8g2/u8g2_font.c **** #ifdef U8G2_WITH_FONT_ROTATION
