 152:BSP/u8g2/u8x8_string.c **** /*
 153:BSP/u8g2/u8x8_string.c ****   draw several lines at position x,y.
 154:BSP/u8g2/u8x8_string.c ****   lines are stored in s and must be separated with '\n'.
 155:BSP/u8g2/u8x8_string.c ****   lines can be centered with respect to "w" 
 156:BSP/u8g2/u8x8_string.c ****   if s == NULL nothing is drawn and 0 is returned
 157:BSP/u8g2/u8x8_string.c ****   returns the number of lines in s
 158:BSP/u8g2/u8x8_string.c **** */
